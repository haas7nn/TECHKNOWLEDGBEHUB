# Prevent PHP execution in uploads directory
<FilesMatch "\.(php|php3|php4|php5|phtml)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow image and media display (svg added for thumbnail support)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|mp4|webm|ogg|avi|doc|docx|zip|txt)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>